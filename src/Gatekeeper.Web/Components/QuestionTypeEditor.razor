@* Type selector + dynamic option-list editor for SingleChoice/MultiChoice questions. Options are
   posted back as repeated "options" form fields (add/remove rows handled client-side by
   wwwroot/js/questionoptions.js, a plain form post — not rewritten to a direct C# call, see
   docs/backlog.md on the MudBlazor migration for why). Captcha isn't offered — no rendering or
   answer-parsing exists for it yet. *@
@inject IJSRuntime JS
@inject Translator T

<label>@T["web.qtype.label"]:
    <select name="type" class="q-type-select" @ref="_select">
        <option value="Text" selected="@(Type == "Text")">@T["web.qtype.text"]</option>
        <option value="SingleChoice" selected="@(Type == "SingleChoice")">@T["web.qtype.single_choice"]</option>
        <option value="MultiChoice" selected="@(Type == "MultiChoice")">@T["web.qtype.multi_choice"]</option>
    </select>
</label>
<div class="q-options" hidden="@(Type is not ("SingleChoice" or "MultiChoice"))">
    <p class="muted">@T["web.qtype.options_label"]</p>
    <div class="q-options-list">
        @if (Options is not null)
        {
            @foreach (var opt in Options)
            {
                <div class="q-option-row">
                    <input type="text" name="options" value="@opt" />
                    <button type="button" class="link q-remove-option">✕</button>
                </div>
            }
        }
    </div>
    <button type="button" class="link q-add-option">@T["web.qtype.add_option"]</button>
</div>

@code {
    [Parameter] public string Type { get; set; } = "Text";
    [Parameter] public IReadOnlyList<string>? Options { get; set; }

    private ElementReference _select;

    // Driven by this component's own render lifecycle, not a document-level DOMContentLoaded/
    // enhancedload listener — see the comment in LocalTime.razor for why (navigation happens over
    // the interactive Server circuit, which never fires either of those page-load events).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("gatekeeperQuestionOptions.init", _select);
    }
}
