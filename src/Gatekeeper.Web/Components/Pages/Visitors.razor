@page "/visitors"
@attribute [Authorize(Roles = "Owner")]
@inject AdminApiClient Api

<h1>Посетители сайта</h1>

@if (_visits is null)
{
    <p>Загрузка…</p>
}
else if (_visits.Count == 0)
{
    <p class="muted">Пока пусто.</p>
}
else
{
    <MudTable Items="_visits" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Когда</MudTh>
            <MudTh>Пользователь</MudTh>
            <MudTh>IP</MudTh>
            <MudTh>Путь</MudTh>
            <MudTh>Метод</MudTh>
            <MudTh>Статус</MudTh>
            <MudTh>Мс</MudTh>
            <MudTh>Откуда пришёл</MudTh>
            <MudTh>User-Agent</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Когда"><LocalTime Value="context.CreatedAt" /></MudTd>
            <MudTd DataLabel="Пользователь">@(context.UserName ?? (context.UserId?.ToString() ?? "—"))</MudTd>
            <MudTd DataLabel="IP">@(context.IpAddress ?? "—")</MudTd>
            <MudTd DataLabel="Путь">@context.Path</MudTd>
            <MudTd DataLabel="Метод">@context.Method</MudTd>
            <MudTd DataLabel="Статус">@context.StatusCode</MudTd>
            <MudTd DataLabel="Мс">@context.DurationMs</MudTd>
            <MudTd DataLabel="Откуда пришёл"><span class="truncate" title="@context.Referrer">@(context.Referrer ?? "—")</span></MudTd>
            <MudTd DataLabel="User-Agent"><span class="truncate" title="@context.UserAgent">@(context.UserAgent ?? "—")</span></MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private IReadOnlyList<SiteVisitDto>? _visits;

    protected override async Task OnInitializedAsync() => _visits = await Api.GetSiteVisitsAsync();
}
