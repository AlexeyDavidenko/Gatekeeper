@page "/visitors"
@attribute [Authorize(Roles = "Owner")]
@inject AdminApiClient Api

<h1>Посетители сайта</h1>

@if (_visits is null)
{
    <p>Загрузка…</p>
}
else if (_visits.Count == 0)
{
    <p class="muted">Пока пусто.</p>
}
else
{
    <div class="table-wrap">
        <table class="grid">
            <thead>
                <tr>
                    <th>Когда</th><th>Пользователь</th><th>IP</th><th>Путь</th><th>Метод</th>
                    <th>Статус</th><th>Мс</th><th>Откуда пришёл</th><th>User-Agent</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in _visits)
                {
                    <tr>
                        <td><LocalTime Value="v.CreatedAt" /></td>
                        <td>@(v.UserName ?? (v.UserId?.ToString() ?? "—"))</td>
                        <td>@(v.IpAddress ?? "—")</td>
                        <td>@v.Path</td>
                        <td>@v.Method</td>
                        <td>@v.StatusCode</td>
                        <td>@v.DurationMs</td>
                        <td class="truncate" title="@v.Referrer">@(v.Referrer ?? "—")</td>
                        <td class="truncate" title="@v.UserAgent">@(v.UserAgent ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<SiteVisitDto>? _visits;

    protected override async Task OnInitializedAsync() => _visits = await Api.GetSiteVisitsAsync();
}
