@page "/login"
@attribute [AllowAnonymous]
@inject IConfiguration Config
@inject NavigationManager Nav
@inject Translator T

<div class="d-flex align-center justify-center" style="min-height: 80vh;">
    <MudPaper Class="pa-8" Style="max-width: 420px; width: 100%;" Elevation="3">
        <div class="d-flex justify-center mb-4">
            <BrandMark IconSize="Size.Large" TextTypo="Typo.h4" />
        </div>
        <MudText Typo="Typo.body1" Class="mud-text-secondary text-center mb-4">@T["web.login.subtitle"]</MudText>

        @if (Error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@Error</MudAlert>
        }

        <div class="d-flex justify-center widget">
            @((MarkupString)WidgetHtml)
        </div>
    </MudPaper>
</div>

@code {
    private string? Error;

    // BotUsername comes from our own config, not user input — safe to inject as markup.
    private string WidgetHtml =>
        $"""<script async src="https://telegram.org/js/telegram-widget.js?22" data-telegram-login="{Config["Telegram:BotUsername"]}" data-size="large" data-auth-url="/auth/telegram" data-request-access="write"></script>""";

    protected override void OnInitialized()
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        if (query.TryGetValue("error", out var e))
            Error = e == "forbidden" ? T["web.login.error_forbidden"] : T["web.login.error_invalid"];
    }
}
