@page "/audit"
@attribute [Authorize(Roles = "Owner")]
@inject AdminApiClient Api

<h1>Аудит-лог</h1>

@if (_log is null)
{
    <p>Загрузка…</p>
}
else if (_log.Count == 0)
{
    <p class="muted">Пока пусто.</p>
}
else
{
    <table class="grid">
        <thead>
            <tr><th>Когда</th><th>Пользователь</th><th>Действие</th><th>Причина</th><th>Кем</th><th>Откуда</th></tr>
        </thead>
        <tbody>
            @foreach (var e in _log)
            {
                <tr>
                    <td><LocalTime Value="e.CreatedAt" /></td>
                    <td>@(e.DisplayName ?? "—") @(e.Username is null ? "" : $"(@{e.Username})")</td>
                    <td>@e.Action</td>
                    <td>@(e.Reason ?? "—")</td>
                    <td>@(e.PerformedByName ?? e.PerformedByUserId.ToString())</td>
                    <td>@e.Source</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<ModerationLogEntry>? _log;

    protected override async Task OnInitializedAsync() => _log = await Api.GetAuditLogAsync();
}
