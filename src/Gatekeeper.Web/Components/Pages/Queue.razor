@page "/queue"
@attribute [Authorize]
@using System.Security.Claims
@inject AdminApiClient Api
@inject NavigationManager Nav
@inject Translator T
@inject IDialogService DialogService

<h1>@T["web.queue.title"]</h1>

@if (_notice == "conflict")
{
    <p class="error">@T["web.queue.notice_conflict"]</p>
}

@if (_apps is null)
{
    <p>@T["web.common.loading"]</p>
}
else if (_apps.Count == 0)
{
    <p class="muted">@T["web.queue.empty"]</p>
}
else
{
    <MudTextField T="string" Value="_searchString" ValueChanged="@((string v) => _searchString = v)"
                  Placeholder="@T["web.common.search"]" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                  Immediate="true" Class="mb-2" />

    <MudDataGrid Items="_apps" Hover="true" Dense="true" SortMode="SortMode.Single" Filterable="false"
                 QuickFilter="@QuickFilter">
        <Columns>
            <PropertyColumn Property="x => x.Id" Title="#" />
            <TemplateColumn Sortable="false" Title="">
                <CellTemplate>
                    <Avatar PhotoFileId="@context.Item.PhotoFileId" DisplayName="@context.Item.DisplayName" Username="@context.Item.Username" />
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.DisplayName" Title="@UserLabel">
                <CellTemplate>
                    @(context.Item.DisplayName ?? T["common.empty_dash"]) @(context.Item.Username is null ? "" : $"(@{context.Item.Username})")
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.SubmittedAt" Title="@SubmittedLabel">
                <CellTemplate><LocalTime Value="context.Item.SubmittedAt" /></CellTemplate>
            </PropertyColumn>
            <TemplateColumn Sortable="false" Title="">
                <CellTemplate>
                    <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success"
                                   title="@T["web.detail.approve_button"]" OnClick="@(() => DecideAsync(context.Item, approve: true))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" Color="Color.Error"
                                   title="@T["web.detail.reject_button"]" OnClick="@(() => DecideAsync(context.Item, approve: false))" />
                    <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small"
                                   title="@T["web.queue.open_link"]" OnClick="@(() => OpenDialogAsync(context.Item.Id))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="ApplicationSummary" />
        </PagerContent>
    </MudDataGrid>
}

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthStateTask { get; set; }

    private IReadOnlyList<ApplicationSummary>? _apps;
    private string? _notice;
    private string _searchString = "";

    private string UserLabel => T["web.dashboard.user_column"];
    private string SubmittedLabel => T["web.queue.submitted_column"];

    protected override async Task OnInitializedAsync()
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        if (query.TryGetValue("notice", out var n)) _notice = n;
        _apps = await Api.GetPendingAsync();
    }

    private bool QuickFilter(ApplicationSummary a)
    {
        if (string.IsNullOrWhiteSpace(_searchString)) return true;
        return a.Id.ToString().Contains(_searchString, StringComparison.OrdinalIgnoreCase)
            || (a.DisplayName?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
            || (a.Username?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    // One-click accept/reject with no reason — a reason field is only offered in the fuller dialog
    // (OpenDialogAsync below), which stays available for anyone who wants to leave one.
    private async Task DecideAsync(ApplicationSummary app, bool approve)
    {
        if (AuthStateTask is null) return;
        var user = (await AuthStateTask).User;
        var actingUserId = long.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var uid) ? uid : 0;

        var outcome = await Api.DecideAsync(app.Id, app.RowVersion, approve, reason: null, actingUserId, user.Identity?.Name);
        _notice = outcome == DecisionOutcome.AlreadyDecided ? "conflict" : null;
        _apps = await Api.GetPendingAsync();
    }

    private async Task OpenDialogAsync(long applicationId)
    {
        var parameters = new DialogParameters<ApplicationDetailDialog> { { d => d.ApplicationId, applicationId } };
        var dialog = await DialogService.ShowAsync<ApplicationDetailDialog>(
            $"{T["web.detail.application_title"]} #{applicationId}", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
            _apps = await Api.GetPendingAsync();
    }
}
