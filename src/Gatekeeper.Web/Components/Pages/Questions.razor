@page "/questions"
@attribute [Authorize]
@inject AdminApiClient Api

<h1>Вопросы анкеты</h1>

@if (_questions is null)
{
    <p>Загрузка…</p>
}
else if (_questions.Count == 0)
{
    <p class="muted">Вопросов пока нет.</p>
}
else
{
    <MudTable Items="_questions" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>#</MudTh>
            <MudTh>Текст</MudTh>
            <MudTh>Тип</MudTh>
            <MudTh>Обязательный</MudTh>
            <MudTh>Активен</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="#">@context.Position</MudTd>
            <MudTd DataLabel="Текст">@((MarkupString)context.PromptText)</MudTd>
            <MudTd DataLabel="Тип">@TypeLabel(context)</MudTd>
            <MudTd DataLabel="Обязательный">@(context.IsRequired ? "да" : "нет")</MudTd>
            <MudTd DataLabel="Активен">@(context.IsActive ? "да" : "нет")</MudTd>
            <MudTd>
                <div class="row-actions">
                    <form method="post" action="questions/@context.Id/move-up" class="inline">
                        <AntiforgeryToken /><button type="submit" class="link" title="Вверх">▲</button>
                    </form>
                    <form method="post" action="questions/@context.Id/move-down" class="inline">
                        <AntiforgeryToken /><button type="submit" class="link" title="Вниз">▼</button>
                    </form>
                    <a href="questions/@context.Id/edit">Редактировать</a>
                    @if (context.IsActive)
                    {
                        <form method="post" action="questions/@context.Id/deactivate" class="inline">
                            <AntiforgeryToken /><button type="submit" class="link">Скрыть</button>
                        </form>
                    }
                </div>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

<h2>Добавить вопрос</h2>
<form method="post" action="questions/create">
    <AntiforgeryToken />
    <RichTextEditor Name="promptText" />
    <label><input type="checkbox" name="isRequired" value="true" /> обязательный</label>
    <QuestionTypeEditor Type="Text" />
    <button type="submit" class="approve">Добавить</button>
</form>

@code {
    private IReadOnlyList<QuestionDto>? _questions;

    protected override async Task OnInitializedAsync() => _questions = await Api.GetQuestionsAsync();

    private static string TypeLabel(QuestionDto q) => q.Type switch
    {
        "SingleChoice" => $"Один вариант ({q.Options?.Count ?? 0})",
        "MultiChoice" => $"Несколько вариантов ({q.Options?.Count ?? 0})",
        _ => "Текст",
    };
}
