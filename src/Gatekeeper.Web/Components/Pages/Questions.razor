@page "/questions"
@attribute [Authorize]
@inject AdminApiClient Api
@inject Translator T
@inject IDialogService DialogService

<div class="d-flex align-center justify-space-between">
    <h1>@T["web.questions.title"]</h1>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               OnClick="@(() => OpenDialogAsync(null))">
        @T["web.questions.add_title"]
    </MudButton>
</div>

@if (_questions is null)
{
    <p>@T["web.common.loading"]</p>
}
else if (_questions.Count == 0)
{
    <p class="muted">@T["web.questions.empty"]</p>
}
else
{
    <MudDataGrid Items="_questions" Hover="true" Dense="true" SortMode="SortMode.Single">
        <Columns>
            <PropertyColumn Property="x => x.Position" Title="#" />
            <PropertyColumn Property="x => x.PromptText" Title="@TextLabel">
                <CellTemplate>@((MarkupString)context.Item.PromptText)</CellTemplate>
            </PropertyColumn>
            <TemplateColumn Sortable="false" Title="@TypeColumnLabel">
                <CellTemplate>@TypeLabel(context.Item)</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="@RequiredLabel">
                <CellTemplate>@(context.Item.IsRequired ? T["web.common.yes"] : T["web.common.no"])</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="@ActiveLabel">
                <CellTemplate>@(context.Item.IsActive ? T["web.common.yes"] : T["web.common.no"])</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="">
                <CellTemplate>
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small"
                                   title="@T["web.questions.move_up"]" OnClick="@(() => MoveAsync(context.Item.Id, up: true))" />
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small"
                                   title="@T["web.questions.move_down"]" OnClick="@(() => MoveAsync(context.Item.Id, up: false))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   title="@T["web.questions.edit_link"]" OnClick="@(() => OpenDialogAsync(context.Item.Id))" />
                    @if (context.Item.IsActive)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.VisibilityOff" Size="Size.Small"
                                       title="@T["web.questions.hide_button"]" OnClick="@(() => DeactivateAsync(context.Item.Id))" />
                    }
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="QuestionDto" RowsPerPageString="@T["web.common.pager.rows_per_page"]"
                              InfoFormat="@T["web.common.pager.info_format"]" AllItemsText="@T["web.common.pager.all_items"]" />
        </PagerContent>
    </MudDataGrid>
}

@code {
    private IReadOnlyList<QuestionDto>? _questions;

    private string TextLabel => T["web.questions.text_column"];
    private string TypeColumnLabel => T["web.qtype.label"];
    private string RequiredLabel => T["web.questions.required_column"];
    private string ActiveLabel => T["web.questions.active_column"];

    protected override async Task OnInitializedAsync() => _questions = await Api.GetQuestionsAsync();

    private string TypeLabel(QuestionDto q) => q.Type switch
    {
        "SingleChoice" => $"{T["web.qtype.single_choice"]} ({q.Options?.Count ?? 0})",
        "MultiChoice" => $"{T["web.qtype.multi_choice"]} ({q.Options?.Count ?? 0})",
        _ => T["web.qtype.text"],
    };

    private async Task MoveAsync(long id, bool up)
    {
        await Api.MoveQuestionAsync(id, up);
        _questions = await Api.GetQuestionsAsync();
    }

    private async Task DeactivateAsync(long id)
    {
        await Api.DeactivateQuestionAsync(id);
        _questions = await Api.GetQuestionsAsync();
    }

    private async Task OpenDialogAsync(long? questionId)
    {
        var parameters = new DialogParameters<QuestionDialog> { { d => d.QuestionId, questionId } };
        var title = questionId is null ? T["web.questions.add_title"] : T["web.questionedit.title"];
        var dialog = await DialogService.ShowAsync<QuestionDialog>(title, parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
            _questions = await Api.GetQuestionsAsync();
    }
}
