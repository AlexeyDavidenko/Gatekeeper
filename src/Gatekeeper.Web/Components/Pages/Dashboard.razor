@page "/"
@attribute [Authorize]
@inject AdminApiClient Api
@inject Translator T

<h1>@T["web.dashboard.title"]</h1>

@if (_summary is null)
{
    <p>@T["web.common.loading"]</p>
}
else
{
    <MudGrid Class="mt-2">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h4">@_summary.PendingCount</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@T["web.dashboard.pending_label"]</MudText>
                <MudLink Href="/queue">@T["web.dashboard.to_queue_link"]</MudLink>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h4">@_summary.ApprovedToday / @_summary.RejectedToday</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@T["web.dashboard.today_label"]</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h4">@_summary.ApprovedWeek / @_summary.RejectedWeek</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@T["web.dashboard.week_label"]</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Style="@(_summary.OutboxFailed > 0 ? "border: 2px solid var(--mud-palette-error)" : "")">
                <MudText Typo="Typo.h4">@_summary.OutboxPending / @_summary.OutboxInFlight / @_summary.OutboxFailed</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@T["web.dashboard.outbox_label"]</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid Class="mt-4">
        <MudItem xs="12" md="8">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.subtitle1" Class="mb-2">@T["web.dashboard.trend_title"]</MudText>
                @if (_hasTrendData)
                {
                    <MudChart ChartType="ChartType.Line" ChartSeries="@_trendSeries" ChartLabels="@_trendLabels"
                              Width="100%" Height="300px" />
                }
                else
                {
                    <MudText Class="d-flex align-center justify-center mud-text-secondary" Style="height: 300px;">
                        @T["web.dashboard.no_chart_data"]
                    </MudText>
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.subtitle1" Class="mb-2">@T["web.dashboard.status_ratio_title"]</MudText>
                @if (_hasStatusData)
                {
                    <MudChart ChartType="ChartType.Donut" ChartSeries="@_statusSeries" ChartLabels="@_statusLabels"
                              Width="100%" Height="300px" />
                }
                else
                {
                    <MudText Class="d-flex align-center justify-center mud-text-secondary" Style="height: 300px;">
                        @T["web.dashboard.no_chart_data"]
                    </MudText>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>

    <h2>@T["web.dashboard.recent_decisions_title"]</h2>
    @if (_summary.RecentDecisions.Count == 0)
    {
        <p class="muted">@T["web.dashboard.no_decisions"]</p>
    }
    else
    {
        <MudTable Items="_summary.RecentDecisions" Hover="true" Dense="true">
            <HeaderContent>
                <MudTh>@WhenLabel</MudTh>
                <MudTh>@UserLabel</MudTh>
                <MudTh>@ActionLabel</MudTh>
                <MudTh>@DecidedByLabel</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@WhenLabel"><LocalTime Value="context.CreatedAt" /></MudTd>
                <MudTd DataLabel="@UserLabel">@(context.DisplayName ?? T["common.empty_dash"]) @(context.Username is null ? "" : $"(@{context.Username})")</MudTd>
                <MudTd DataLabel="@ActionLabel">@(context.Action == "Approve" ? T["web.dashboard.approved"] : T["web.dashboard.rejected"])</MudTd>
                <MudTd DataLabel="@DecidedByLabel">@(context.PerformedByName ?? context.PerformedByUserId.ToString())</MudTd>
            </RowTemplate>
        </MudTable>
    }
}

@code {
    private DashboardSummary? _summary;

    private List<ChartSeries<double>> _trendSeries = [];
    private string[] _trendLabels = [];
    private List<ChartSeries<double>> _statusSeries = [];
    private string[] _statusLabels = [];
    private bool _hasTrendData;
    private bool _hasStatusData;

    private string WhenLabel => T["web.dashboard.when_column"];
    private string UserLabel => T["web.dashboard.user_column"];
    private string ActionLabel => T["web.dashboard.action_column"];
    private string DecidedByLabel => T["web.dashboard.decided_by_column"];

    protected override async Task OnInitializedAsync()
    {
        _summary = await Api.GetDashboardAsync();

        _trendLabels = _summary.Trend.Select(t => t.Day.ToString("dd.MM")).ToArray();
        _trendSeries =
        [
            new ChartSeries<double>
            {
                Name = T["web.dashboard.approved"],
                Data = new ChartData<double>(_summary.Trend.Select(t => (double)t.Approved).ToList()),
            },
            new ChartSeries<double>
            {
                Name = T["web.dashboard.rejected"],
                Data = new ChartData<double>(_summary.Trend.Select(t => (double)t.Rejected).ToList()),
            },
        ];

        _statusLabels = [T["web.dashboard.pending_label"], T["web.dashboard.week_label_approved"], T["web.dashboard.week_label_rejected"]];
        _statusSeries =
        [
            new ChartSeries<double>
            {
                Name = T["web.dashboard.status_ratio_title"],
                Data = new ChartData<double>((IReadOnlyList<double>)[_summary.PendingCount, _summary.ApprovedWeek, _summary.RejectedWeek]),
            },
        ];

        _hasTrendData = _summary.Trend.Any(t => t.Approved > 0 || t.Rejected > 0);
        _hasStatusData = _summary.PendingCount > 0 || _summary.ApprovedWeek > 0 || _summary.RejectedWeek > 0;
    }
}
