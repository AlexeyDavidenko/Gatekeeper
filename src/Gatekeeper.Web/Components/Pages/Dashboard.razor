@page "/"
@attribute [Authorize]
@inject AdminApiClient Api

<h1>Дашборд</h1>

@if (_summary is null)
{
    <p>Загрузка…</p>
}
else
{
    <MudGrid Class="mt-2">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h4">@_summary.PendingCount</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Ждут решения</MudText>
                <MudLink Href="/queue">К очереди →</MudLink>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h4">@_summary.ApprovedToday / @_summary.RejectedToday</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Одобрено / отклонено сегодня</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h4">@_summary.ApprovedWeek / @_summary.RejectedWeek</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Одобрено / отклонено за 7 дней</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Style="@(_summary.OutboxFailed > 0 ? "border: 2px solid var(--mud-palette-error)" : "")">
                <MudText Typo="Typo.h4">@_summary.OutboxPending / @_summary.OutboxInFlight / @_summary.OutboxFailed</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Outbox: ожидают / в полёте / ошибки</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <h2>Последние решения</h2>
    @if (_summary.RecentDecisions.Count == 0)
    {
        <p class="muted">Пока нет решений.</p>
    }
    else
    {
        <MudTable Items="_summary.RecentDecisions" Hover="true" Dense="true">
            <HeaderContent>
                <MudTh>Когда</MudTh>
                <MudTh>Пользователь</MudTh>
                <MudTh>Действие</MudTh>
                <MudTh>Кто решил</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Когда"><LocalTime Value="context.CreatedAt" /></MudTd>
                <MudTd DataLabel="Пользователь">@(context.DisplayName ?? "—") @(context.Username is null ? "" : $"(@{context.Username})")</MudTd>
                <MudTd DataLabel="Действие">@(context.Action == "Approve" ? "✅ Одобрено" : "❌ Отклонено")</MudTd>
                <MudTd DataLabel="Кто решил">@(context.PerformedByName ?? context.PerformedByUserId.ToString())</MudTd>
            </RowTemplate>
        </MudTable>
    }
}

@code {
    private DashboardSummary? _summary;

    protected override async Task OnInitializedAsync() => _summary = await Api.GetDashboardAsync();
}
