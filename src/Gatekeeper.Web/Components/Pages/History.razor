@page "/history"
@attribute [Authorize]
@inject AdminApiClient Api
@inject NavigationManager Nav
@inject Translator T
@inject IDialogService DialogService

<h1>@T["web.history.title"]</h1>

@if (_apps is null)
{
    <p>@T["web.common.loading"]</p>
}
else if (_apps.Count == 0)
{
    <p class="muted">@T["web.history.empty"]</p>
}
else
{
    <MudDataGrid Items="_apps" Hover="true" Dense="true" SortMode="SortMode.Single">
        <Columns>
            <PropertyColumn Property="x => x.Id" Title="#" />
            <TemplateColumn Sortable="false" Title="">
                <CellTemplate>
                    <Avatar PhotoFileId="@context.Item.PhotoFileId" DisplayName="@context.Item.DisplayName" Username="@context.Item.Username" />
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.DisplayName" Title="@UserLabel">
                <CellTemplate>
                    @(context.Item.DisplayName ?? T["common.empty_dash"]) @(context.Item.Username is null ? "" : $"(@{context.Item.Username})")
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Status" Title="@StatusLabel">
                <CellTemplate>@(context.Item.Status == "Approved" ? T["web.history.approved"] : T["web.history.rejected"])</CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.SubmittedAt" Title="@SubmittedLabel">
                <CellTemplate><LocalTime Value="context.Item.SubmittedAt" /></CellTemplate>
            </PropertyColumn>
            @if (_isOwner)
            {
                <TemplateColumn Sortable="false" Title="@ByLabel">
                    <CellTemplate>
                        @{ var decision = _decisions.GetValueOrDefault(context.Item.Id); }
                        @(decision?.PerformedByName ?? decision?.PerformedByUserId.ToString() ?? T["common.empty_dash"])
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Sortable="false" Title="@SourceLabel">
                    <CellTemplate>@(_decisions.GetValueOrDefault(context.Item.Id)?.Source ?? T["common.empty_dash"])</CellTemplate>
                </TemplateColumn>
            }
            <TemplateColumn Sortable="false" Title="">
                <CellTemplate>
                    <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small"
                                   title="@T["web.queue.open_link"]" OnClick="@(() => OpenDialogAsync(context.Item.Id))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="ApplicationSummary" />
        </PagerContent>
    </MudDataGrid>
}

<AuthorizeView Context="archiveContext" Roles="Owner">
    <Authorized>
        <h2>@T["web.history.archive_title"]</h2>
        <form method="post" action="history/archive" class="inline">
            <AntiforgeryToken />
            <label>@T["web.history.archive_older_than_label"]
                <input type="date" name="olderThan" required />
            </label>
            <button type="submit" class="approve">@T["web.history.archive_button"]</button>
        </form>
        @if (Archived is not null)
        {
            <p class="muted">@T["web.history.archived_count"]: @Archived</p>
        }

        @if (IncludeArchived)
        {
            <a href="/history">@T["web.history.hide_archived_link"]</a>
        }
        else
        {
            <a href="/history?includeArchived=true">@T["web.history.show_archived_link"]</a>
        }

        @if (IncludeArchived)
        {
            @if (_archived.Count == 0)
            {
                <p class="muted">@T["web.history.archive_empty"]</p>
            }
            else
            {
                @if (_selectedArchived.Count > 0)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="my-2"
                               OnClick="RestoreSelectedAsync">
                        @T["web.history.unarchive_selected_button"] (@_selectedArchived.Count)
                    </MudButton>
                }

                <MudDataGrid Items="_archived" Hover="true" Dense="true" SortMode="SortMode.Single"
                             MultiSelection="true" @bind-SelectedItems="_selectedArchived">
                    <Columns>
                        <SelectColumn T="ModerationLogEntry" />
                        <PropertyColumn Property="x => x.CreatedAt" Title="@WhenLabel">
                            <CellTemplate><LocalTime Value="context.Item.CreatedAt" /></CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.Action" Title="@ActionLabel" />
                        <TemplateColumn Sortable="false" Title="@ApplicationLabel">
                            <CellTemplate>@(context.Item.ApplicationId?.ToString() ?? T["common.empty_dash"])</CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Sortable="false" Title="@ByLabel">
                            <CellTemplate>@(context.Item.PerformedByName ?? context.Item.PerformedByUserId.ToString())</CellTemplate>
                        </TemplateColumn>
                        <PropertyColumn Property="x => x.ArchivedAt" Title="@ArchivedAtLabel">
                            <CellTemplate><LocalTime Value="context.Item.ArchivedAt" /></CellTemplate>
                        </PropertyColumn>
                        <TemplateColumn Sortable="false" Title="">
                            <CellTemplate>
                                <MudIconButton Icon="@Icons.Material.Filled.Restore" Size="Size.Small"
                                               title="@T["web.history.unarchive_button"]"
                                               OnClick="@(() => RestoreAsync(context.Item.Id))" />
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <PagerContent>
                        <MudDataGridPager T="ModerationLogEntry" />
                    </PagerContent>
                </MudDataGrid>
            }
        }
    </Authorized>
</AuthorizeView>

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthStateTask { get; set; }

    private bool IncludeArchived;
    private int? Archived;
    private bool _isOwner;

    private IReadOnlyList<ApplicationSummary>? _apps;
    private Dictionary<long, ModerationLogEntry> _decisions = [];
    private IReadOnlyList<ModerationLogEntry> _archived = [];
    private HashSet<ModerationLogEntry> _selectedArchived = [];

    private string UserLabel => T["web.dashboard.user_column"];
    private string StatusLabel => T["web.detail.status_label"];
    private string SubmittedLabel => T["web.queue.submitted_column"];
    private string ByLabel => T["web.history.by_column"];
    private string SourceLabel => T["web.history.source_column"];
    private string WhenLabel => T["web.dashboard.when_column"];
    private string ActionLabel => T["web.dashboard.action_column"];
    private string ApplicationLabel => T["web.history.application_column"];
    private string ArchivedAtLabel => T["web.history.archived_at_column"];

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            _isOwner = state.User.IsInRole("Owner");
        }

        // Same manual query-string read as Login.razor's "?error=" — this app has no
        // [SupplyParameterFromQuery] precedent, keep the one established pattern.
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        IncludeArchived = query.TryGetValue("includeArchived", out var ia) && ia == "true";
        if (query.TryGetValue("archived", out var a) && int.TryParse(a, out var archivedCount))
            Archived = archivedCount;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var approved = await Api.GetByStatusAsync("Approved");
        var rejected = await Api.GetByStatusAsync("Rejected");
        _apps = approved.Concat(rejected).OrderByDescending(a => a.SubmittedAt).ToList();

        // "Кем"/"Откуда" — same audit-log data as /audit, just joined onto each application by id
        // (only Owners see these two columns; the fetch itself is harmless either way since the
        // column itself is hidden server-side for anyone else). Archived decisions stay out of
        // this join on purpose — archiving hides "internal kitchen" audit detail, not the
        // application itself, which the main table above always shows regardless.
        var log = await Api.GetAuditLogAsync();
        _decisions = log
            .Where(e => e.ApplicationId is not null && e.Action is "Approve" or "Reject")
            .GroupBy(e => e.ApplicationId!.Value)
            .ToDictionary(g => g.Key, g => g.OrderByDescending(e => e.CreatedAt).First());

        if (IncludeArchived)
        {
            var full = await Api.GetAuditLogAsync(includeArchived: true);
            _archived = full.Where(e => e.IsArchived).OrderByDescending(e => e.ArchivedAt).ToList();
        }
    }

    private async Task RestoreAsync(long id)
    {
        await Api.UnarchiveModerationActionAsync(id);
        await LoadAsync();
    }

    private async Task RestoreSelectedAsync()
    {
        await Api.UnarchiveModerationActionsAsync(_selectedArchived.Select(e => e.Id).ToList());
        _selectedArchived = [];
        await LoadAsync();
    }

    private async Task OpenDialogAsync(long applicationId)
    {
        var parameters = new DialogParameters<ApplicationDetailDialog> { { d => d.ApplicationId, applicationId } };
        var dialog = await DialogService.ShowAsync<ApplicationDetailDialog>(
            $"{T["web.detail.application_title"]} #{applicationId}", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await LoadAsync();
    }
}
