@page "/history"
@attribute [Authorize]
@inject AdminApiClient Api
@inject NavigationManager Nav
@inject Translator T

<h1>@T["web.history.title"]</h1>

@if (_apps is null)
{
    <p>@T["web.common.loading"]</p>
}
else if (_apps.Count == 0)
{
    <p class="muted">@T["web.history.empty"]</p>
}
else
{
    <MudTable Items="_apps" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>#</MudTh>
            <MudTh></MudTh>
            <MudTh>@UserLabel</MudTh>
            <MudTh>@StatusLabel</MudTh>
            <MudTh>@SubmittedLabel</MudTh>
            <AuthorizeView Context="ownerContext" Roles="Owner">
                <Authorized><MudTh>@ByLabel</MudTh><MudTh>@SourceLabel</MudTh></Authorized>
            </AuthorizeView>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="#">@context.Id</MudTd>
            <MudTd><Avatar PhotoFileId="@context.PhotoFileId" DisplayName="@context.DisplayName" Username="@context.Username" /></MudTd>
            <MudTd DataLabel="@UserLabel">@(context.DisplayName ?? T["common.empty_dash"]) @(context.Username is null ? "" : $"(@{context.Username})")</MudTd>
            <MudTd DataLabel="@StatusLabel">@(context.Status == "Approved" ? T["web.history.approved"] : T["web.history.rejected"])</MudTd>
            <MudTd DataLabel="@SubmittedLabel"><LocalTime Value="context.SubmittedAt" /></MudTd>
            <AuthorizeView Context="ownerContext" Roles="Owner">
                <Authorized>
                    @{ var decision = _decisions.GetValueOrDefault(context.Id); }
                    <MudTd DataLabel="@ByLabel">@(decision?.PerformedByName ?? decision?.PerformedByUserId.ToString() ?? T["common.empty_dash"])</MudTd>
                    <MudTd DataLabel="@SourceLabel">@(decision?.Source ?? T["common.empty_dash"])</MudTd>
                </Authorized>
            </AuthorizeView>
            <MudTd><a href="applications/@context.Id">@T["web.queue.open_link"]</a></MudTd>
        </RowTemplate>
    </MudTable>
}

<AuthorizeView Context="archiveContext" Roles="Owner">
    <Authorized>
        <h2>@T["web.history.archive_title"]</h2>
        <form method="post" action="history/archive" class="inline">
            <AntiforgeryToken />
            <label>@T["web.history.archive_older_than_label"]
                <input type="date" name="olderThan" required />
            </label>
            <button type="submit" class="approve">@T["web.history.archive_button"]</button>
        </form>
        @if (Archived is not null)
        {
            <p class="muted">@T["web.history.archived_count"]: @Archived</p>
        }

        @if (IncludeArchived)
        {
            <a href="/history">@T["web.history.hide_archived_link"]</a>
        }
        else
        {
            <a href="/history?includeArchived=true">@T["web.history.show_archived_link"]</a>
        }

        @if (IncludeArchived)
        {
            @if (_archived.Count == 0)
            {
                <p class="muted">@T["web.history.archive_empty"]</p>
            }
            else
            {
                <MudTable Items="_archived" Hover="true" Dense="true">
                    <HeaderContent>
                        <MudTh>@WhenLabel</MudTh>
                        <MudTh>@ActionLabel</MudTh>
                        <MudTh>@ApplicationLabel</MudTh>
                        <MudTh>@ByLabel</MudTh>
                        <MudTh>@ArchivedAtLabel</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="@WhenLabel"><LocalTime Value="context.CreatedAt" /></MudTd>
                        <MudTd DataLabel="@ActionLabel">@context.Action</MudTd>
                        <MudTd DataLabel="@ApplicationLabel">@(context.ApplicationId?.ToString() ?? T["common.empty_dash"])</MudTd>
                        <MudTd DataLabel="@ByLabel">@(context.PerformedByName ?? context.PerformedByUserId.ToString())</MudTd>
                        <MudTd DataLabel="@ArchivedAtLabel"><LocalTime Value="context.ArchivedAt" /></MudTd>
                        <MudTd>
                            <form method="post" action="history/@context.Id/unarchive" class="inline">
                                <AntiforgeryToken /><button type="submit" class="link">@T["web.history.unarchive_button"]</button>
                            </form>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        }
    </Authorized>
</AuthorizeView>

@code {
    private bool IncludeArchived;
    private int? Archived;

    private IReadOnlyList<ApplicationSummary>? _apps;
    private Dictionary<long, ModerationLogEntry> _decisions = [];
    private IReadOnlyList<ModerationLogEntry> _archived = [];

    private string UserLabel => T["web.dashboard.user_column"];
    private string StatusLabel => T["web.detail.status_label"];
    private string SubmittedLabel => T["web.queue.submitted_column"];
    private string ByLabel => T["web.history.by_column"];
    private string SourceLabel => T["web.history.source_column"];
    private string WhenLabel => T["web.dashboard.when_column"];
    private string ActionLabel => T["web.dashboard.action_column"];
    private string ApplicationLabel => T["web.history.application_column"];
    private string ArchivedAtLabel => T["web.history.archived_at_column"];

    protected override async Task OnInitializedAsync()
    {
        // Same manual query-string read as Login.razor's "?error=" — this app has no
        // [SupplyParameterFromQuery] precedent, keep the one established pattern.
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        IncludeArchived = query.TryGetValue("includeArchived", out var ia) && ia == "true";
        if (query.TryGetValue("archived", out var a) && int.TryParse(a, out var archivedCount))
            Archived = archivedCount;

        var approved = await Api.GetByStatusAsync("Approved");
        var rejected = await Api.GetByStatusAsync("Rejected");
        _apps = approved.Concat(rejected).OrderByDescending(a => a.SubmittedAt).ToList();

        // "Кем"/"Откуда" — same audit-log data as /audit, just joined onto each application by id
        // (only Owners see these two columns; the fetch itself is harmless either way since
        // AuthorizeView suppresses rendering server-side for anyone else). Archived decisions stay
        // out of this join on purpose — archiving hides "internal kitchen" audit detail, not the
        // application itself, which the main table above always shows regardless.
        var log = await Api.GetAuditLogAsync();
        _decisions = log
            .Where(e => e.ApplicationId is not null && e.Action is "Approve" or "Reject")
            .GroupBy(e => e.ApplicationId!.Value)
            .ToDictionary(g => g.Key, g => g.OrderByDescending(e => e.CreatedAt).First());

        if (IncludeArchived)
        {
            var full = await Api.GetAuditLogAsync(includeArchived: true);
            _archived = full.Where(e => e.IsArchived).OrderByDescending(e => e.ArchivedAt).ToList();
        }
    }
}
