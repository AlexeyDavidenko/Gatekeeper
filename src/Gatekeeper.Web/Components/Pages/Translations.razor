@page "/translations"
@attribute [Authorize(Roles = "Owner")]
@inject AdminApiClient Api
@inject Translator T

<h1>@T["web.translations.title"]</h1>
<p class="muted">@T["web.translations.subtitle"]</p>

@if (_groups is null)
{
    <p>@T["web.common.loading"]</p>
}
else
{
    <MudTextField T="string" Value="_searchString" ValueChanged="OnSearchChanged"
                  Placeholder="@T["web.common.search"]" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                  Immediate="true" Class="mb-2" />

    <MudExpansionPanels>
        @foreach (var group in FilteredGroups())
        {
            <MudExpansionPanel Text="@group.Prefix" Expanded="@GetExpanded(group.Prefix)"
                                ExpandedChanged="@((bool v) => _expanded[group.Prefix] = v)">
                @foreach (var row in group.Rows)
                {
                    <form method="post" action="translations/save" class="translation-row">
                        <AntiforgeryToken />
                        <input type="hidden" name="key" value="@row.Key" />
                        <code class="translation-key">@row.Key</code>
                        <label>RU
                            <input type="text" name="ru" value="@row.Ru" />
                        </label>
                        <label>EN
                            <input type="text" name="en" value="@row.En" />
                        </label>
                        <button type="submit" class="link">@T["web.translations.save_button"]</button>
                    </form>
                }
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
}

@code {
    private sealed record Row(string Key, string? Ru, string? En);
    private sealed record Group(string Prefix, List<Row> Rows);

    private List<Group>? _groups;
    private string _searchString = "";
    private readonly Dictionary<string, bool> _expanded = [];

    protected override async Task OnInitializedAsync()
    {
        var all = await Api.GetTranslationsAsync();
        var byKey = all.GroupBy(t => t.Key)
            .Select(g => new Row(
                g.Key,
                g.FirstOrDefault(t => t.LanguageCode == "ru")?.Value,
                g.FirstOrDefault(t => t.LanguageCode == "en")?.Value))
            .OrderBy(r => r.Key, StringComparer.Ordinal);

        // Group by the first two dot segments — matches this migration's own key-naming
        // convention (surface + page/concern), e.g. "bot.admin.stats_title" -> "bot.admin".
        _groups = byKey
            .GroupBy(r => string.Join('.', r.Key.Split('.').Take(2)))
            .OrderBy(g => g.Key, StringComparer.Ordinal)
            .Select(g => new Group(g.Key, g.ToList()))
            .ToList();
    }

    private bool GetExpanded(string prefix) => _expanded.GetValueOrDefault(prefix);

    private void OnSearchChanged(string value)
    {
        _searchString = value;
        if (string.IsNullOrWhiteSpace(value)) return;

        // Force-expand every panel that has at least one match — jumps the admin straight to the
        // key they're looking for instead of them having to open ~40 panels by hand.
        foreach (var group in _groups ?? [])
        {
            if (group.Rows.Any(Matches))
                _expanded[group.Prefix] = true;
        }
    }

    // Only the matching rows render inside a matching panel — keeps the search result focused on
    // exactly what was typed rather than showing the whole (possibly large) group alongside it.
    private IEnumerable<Group> FilteredGroups()
    {
        if (_groups is null) yield break;
        if (string.IsNullOrWhiteSpace(_searchString))
        {
            foreach (var g in _groups) yield return g;
            yield break;
        }

        foreach (var group in _groups)
        {
            var matches = group.Rows.Where(Matches).ToList();
            if (matches.Count > 0) yield return group with { Rows = matches };
        }
    }

    private bool Matches(Row row) =>
        row.Key.Contains(_searchString, StringComparison.OrdinalIgnoreCase)
        || (row.Ru?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
        || (row.En?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false);
}
