@page "/Error"
@using System.Diagnostics
@inject Translator T

<PageTitle>@T["web.error.title"]</PageTitle>

<h1 class="text-danger">@T["web.error.title"]</h1>
<h2 class="text-danger">@T["web.error.subtitle"]</h2>

@if (ShowRequestId)
{
    <p>
        <strong>@T["web.error.request_id"]:</strong> <code>@RequestId</code>
    </p>
}

<h3>@T["web.error.dev_mode_title"]</h3>
<p>
    @T["web.error.dev_mode_body1"]
</p>
<p>
    <strong>@T["web.error.dev_mode_warning"]</strong>
    @T["web.error.dev_mode_body2"]
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
