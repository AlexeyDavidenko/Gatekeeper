@page "/applications/{Id:long}"
@attribute [Authorize]
@using System.Security.Claims
@inject AdminApiClient Api
@inject Translator T
@inject IDialogService DialogService

<p><a href="/queue">@T["web.detail.back_to_queue"]</a></p>

@if (_card is null)
{
    <p>@T["web.common.loading"]</p>
}
else
{
    <h1>@T["web.detail.application_title"] #@_card.Id</h1>
    <p>
        <Avatar PhotoFileId="@_card.PhotoFileId" DisplayName="@_card.DisplayName" Username="@_card.Username" Large="true" />
        @(_card.DisplayName ?? T["common.empty_dash"]) @(_card.Username is null ? "" : $"(@{_card.Username})")
    </p>
    <p class="muted">@T["web.detail.status_label"]: @StatusLabel(_card.Status)</p>
    @if (!string.IsNullOrWhiteSpace(_card.Bio))
    {
        <p class="bio">ℹ️ @_card.Bio</p>
    }

    <div class="answers">
        @foreach (var ans in _card.Answers)
        {
            <div class="answer">
                <div class="q">@ans.Position. @((MarkupString)ans.Prompt)</div>
                <div class="a">@(string.IsNullOrWhiteSpace(ans.Text) ? T["common.empty_dash"] : ans.Text)</div>
            </div>
        }
    </div>

    @if (_card.Status == "AwaitingReview")
    {
        <div class="actions">
            <form method="post" action="applications/@_card.Id/approve">
                <AntiforgeryToken />
                <input type="hidden" name="rowVersion" value="@_card.RowVersion" />
                <button type="submit" class="approve">@T["web.detail.approve_button"]</button>
            </form>
            <form method="post" action="applications/@_card.Id/reject">
                <AntiforgeryToken />
                <input type="hidden" name="rowVersion" value="@_card.RowVersion" />
                <input type="text" name="reason" placeholder="@ReasonPlaceholder" />
                <button type="submit" class="reject">@T["web.detail.reject_button"]</button>
            </form>
        </div>
    }
    else
    {
        <p class="muted">@T["web.detail.already_decided"]</p>
    }

    <div class="moderation">
        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Gavel"
                   OnClick="OpenModerationDialogAsync">
            @T["web.detail.moderation_title"]
        </MudButton>
    </div>
}

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthStateTask { get; set; }
    [Parameter] public long Id { get; set; }

    private ApplicationCard? _card;

    private string ReasonPlaceholder => T["web.detail.reason_placeholder"];

    private string StatusLabel(string status) => status switch
    {
        "JoinRequested" => T["web.detail.status.join_requested"],
        "SurveyOffered" => T["web.detail.status.survey_offered"],
        "InSurvey" => T["web.detail.status.in_survey"],
        "AwaitingReview" => T["web.detail.status.awaiting_review"],
        "Approved" => T["web.detail.status.approved"],
        "Rejected" => T["web.detail.status.rejected"],
        "Abandoned" => T["web.detail.status.abandoned"],
        "Cancelled" => T["web.detail.status.cancelled"],
        _ => status,
    };

    protected override async Task OnInitializedAsync() => _card = await Api.GetCardAsync(Id);

    private async Task OpenModerationDialogAsync()
    {
        if (_card is null || AuthStateTask is null) return;
        var user = (await AuthStateTask).User;
        var actingUserId = long.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var uid) ? uid : 0;

        var parameters = new DialogParameters<ModerationDialog>
        {
            { d => d.TelegramUserId, _card.TelegramUserId },
            { d => d.ChatId, _card.ChatId },
            { d => d.ActingUserId, actingUserId },
            { d => d.ActingUserName, user.Identity?.Name },
        };
        var dialog = await DialogService.ShowAsync<ModerationDialog>(T["web.detail.moderation_title"], parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
            _card = await Api.GetCardAsync(Id);
    }
}
