<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>Gatekeeper</title>
    <style>
        :root {
            color-scheme: light dark;
            --bg: #ffffff;
            --fg: #16181d;
            --muted-fg: #667085;
            --border: #e2e5ea;
            --card-bg: #f7f8fa;
            --surface-hover: #eef0f3;
            --link: #2563eb;
            --focus: #258cfb;
            --success: #16a34a;
            --success-hover: #15803d;
            --danger: #dc2626;
            --danger-hover: #b91c1c;
            --on-accent: #ffffff;
        }

        @@media (prefers-color-scheme: dark) {
            :root {
                --bg: #14161a;
                --fg: #e6e8eb;
                --muted-fg: #9aa1ab;
                --border: #2b2f36;
                --card-bg: #1c1f24;
                --surface-hover: #23272e;
                --link: #6ea8fe;
                --focus: #6ea8fe;
                --success: #22c55e;
                --success-hover: #16a34a;
                --danger: #f87171;
                --danger-hover: #ef4444;
                --on-accent: #0b0c0e;
            }
        }

        * { box-sizing: border-box; }
        body { font-family: system-ui, sans-serif; margin: 0; line-height: 1.5; background: var(--bg); color: var(--fg); }
        a, .btn-link { color: var(--link); }
        h1 { font-size: 1.5rem; margin: 1rem 0; }
        h2 { font-size: 1.15rem; margin: 1.75rem 0 .75rem; }
        .page { max-width: 860px; margin: 0 auto; padding: 0 1rem 3rem; }
        .topbar { display: flex; align-items: center; gap: .25rem 1rem; flex-wrap: wrap; padding: 1rem 0; border-bottom: 1px solid var(--border); }
        .brand { font-weight: 700; text-decoration: none; color: inherit; margin-right: auto; font-size: 1.1rem; }
        .nav { text-decoration: none; color: var(--muted-fg); padding: .3rem 0; border-bottom: 2px solid transparent; }
        .nav:hover { color: var(--fg); }
        .nav.active { color: var(--fg); border-bottom-color: var(--link); font-weight: 600; }
        .user { opacity: .7; font-size: .9rem; }
        .inline { display: inline; }
        button.link { background: none; border: none; color: var(--link); cursor: pointer; padding: 0; font-size: 1rem; }
        button.link:hover { text-decoration: underline; }
        .table-wrap { overflow-x: auto; margin-top: 1rem; }
        table.grid { width: 100%; border-collapse: collapse; }
        table.grid th, table.grid td { text-align: left; padding: .6rem .5rem; border-bottom: 1px solid var(--border); white-space: nowrap; }
        table.grid tbody tr:hover { background: var(--surface-hover); }
        .muted { opacity: .7; }
        .error { color: var(--danger); }
        .answers { margin: 1rem 0; }
        .answer { padding: .6rem 0; border-bottom: 1px solid var(--border); }
        .answer .q { font-weight: 600; }
        .actions { display: flex; gap: 1.5rem; flex-wrap: wrap; margin-top: 1.5rem; }
        .actions form { display: flex; gap: .5rem; align-items: center; flex-wrap: wrap; }
        .row-actions { display: flex; gap: .6rem; align-items: center; flex-wrap: wrap; }
        button.approve, button.reject { color: var(--on-accent); border: 0; padding: .5rem 1rem; border-radius: .375rem; cursor: pointer; font-size: .95rem; }
        button.approve { background: var(--success); }
        button.approve:hover { background: var(--success-hover); }
        button.reject { background: var(--danger); }
        button.reject:hover { background: var(--danger-hover); }
        input[type=text] { padding: .45rem .5rem; border: 1px solid var(--border); border-radius: .375rem; background: var(--bg); color: var(--fg); max-width: 100%; }
        .cards { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 1rem; }
        .card { flex: 1 1 180px; border: 1px solid var(--border); background: var(--card-bg); border-radius: .5rem; padding: 1rem; }
        .card-value { font-size: 1.5rem; font-weight: 700; }
        .card-label { opacity: .7; font-size: .85rem; margin-top: .25rem; }
        .card-warn { border-color: var(--danger); }
        .avatar { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; vertical-align: middle; margin-right: .5rem; }
        .avatar-fallback { display: inline-flex; align-items: center; justify-content: center; color: #fff; font-weight: 600; font-size: .8rem; }
        .avatar-lg { width: 72px; height: 72px; font-size: 1.5rem; }
        .bio { opacity: .8; font-style: italic; }
        .rte { border: 1px solid var(--border); border-radius: .375rem; overflow: hidden; }
        .rte-toolbar { display: flex; gap: .25rem; padding: .3rem; border-bottom: 1px solid var(--border); background: var(--card-bg); }
        .rte-toolbar button { background: none; border: 1px solid transparent; border-radius: .25rem; padding: .25rem .5rem; cursor: pointer; font-size: .9rem; color: inherit; line-height: 1; }
        .rte-toolbar button:hover { border-color: var(--border); }
        .rte-editor { padding: .45rem .5rem; min-height: 1.4rem; outline: none; }
        .rte-editor a { color: var(--link); }
        .truncate { max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .q-options { margin: .5rem 0; }
        .q-option-row { display: flex; gap: .5rem; align-items: center; margin: .25rem 0; }
        .q-option-row input[type=text] { flex: 1; }
        .widget { max-width: 100%; overflow-x: auto; }
        button:focus-visible, a:focus-visible, input:focus-visible, [contenteditable]:focus-visible {
            outline: 2px solid var(--focus); outline-offset: 2px;
        }

        @@media (max-width: 640px) {
            .page { padding: 0 .75rem 2rem; }
            .topbar { gap: .5rem .75rem; }
            .actions { flex-direction: column; gap: .75rem; }
            .cards { gap: .75rem; }
            .card { flex-basis: 100%; }
        }
    </style>
    <HeadOutlet />
</head>
<body>
    <Routes />
    <script src="js/localtime.js"></script>
    <script src="js/richtext.js"></script>
    <script src="js/questionoptions.js"></script>
</body>
</html>
