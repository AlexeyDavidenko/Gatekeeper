@inject LocaleContext Locale
<!DOCTYPE html>
<html lang="@Locale.LanguageCode">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>Gatekeeper</title>
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <style>
        :root {
            color-scheme: light dark;
            --bg: #ffffff;
            --fg: #16181d;
            --muted-fg: #667085;
            --border: #e2e5ea;
            --card-bg: #f7f8fa;
            --surface-hover: #eef0f3;
            --link: #2563eb;
            --focus: #258cfb;
            --success: #16a34a;
            --success-hover: #15803d;
            --danger: #dc2626;
            --danger-hover: #b91c1c;
            --on-accent: #ffffff;
        }

        @@media (prefers-color-scheme: dark) {
            :root {
                --bg: #14161a;
                --fg: #e6e8eb;
                --muted-fg: #9aa1ab;
                --border: #2b2f36;
                --card-bg: #1c1f24;
                --surface-hover: #23272e;
                --link: #6ea8fe;
                --focus: #6ea8fe;
                --success: #22c55e;
                --success-hover: #16a34a;
                --danger: #f87171;
                --danger-hover: #ef4444;
                --on-accent: #0b0c0e;
            }
        }

        * { box-sizing: border-box; }
        body { font-family: system-ui, sans-serif; margin: 0; line-height: 1.5; background: var(--bg); color: var(--fg); }
        a, .btn-link { color: var(--link); }
        h1 { font-size: 1.5rem; margin: 1rem 0; }
        h2 { font-size: 1.15rem; margin: 1.75rem 0 .75rem; }
        /* No max-width/margin:auto here on purpose — MudDrawer already reserves its own space on the
           left, so the rest should just fill whatever's left of the viewport (grids, charts, dialogs
           all benefit from the extra room instead of sitting in a narrow centered column). */
        .page { padding: 1.5rem 2rem 3rem; }
        .user { opacity: .7; font-size: .9rem; }
        .inline { display: inline; }
        button.link { background: none; border: none; color: var(--link); cursor: pointer; padding: 0; font-size: 1rem; }
        button.link:hover { text-decoration: underline; }
        .muted { opacity: .7; }
        .error { color: var(--danger); }
        .answers { margin: 1rem 0; }
        .answer { padding: .6rem 0; border-bottom: 1px solid var(--border); }
        .answer .q { font-weight: 600; }
        .actions { display: flex; gap: 1.5rem; flex-wrap: wrap; margin-top: 1.5rem; }
        .actions form { display: flex; gap: .5rem; align-items: center; flex-wrap: wrap; }
        .row-actions { display: flex; gap: .6rem; align-items: center; flex-wrap: wrap; }
        button.approve, button.reject { color: var(--on-accent); border: 0; padding: .5rem 1rem; border-radius: .375rem; cursor: pointer; font-size: .95rem; }
        button.approve { background: var(--success); }
        button.approve:hover { background: var(--success-hover); }
        button.reject { background: var(--danger); }
        button.reject:hover { background: var(--danger-hover); }
        input[type=text] { padding: .45rem .5rem; border: 1px solid var(--border); border-radius: .375rem; background: var(--bg); color: var(--fg); max-width: 100%; }
        .avatar { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; vertical-align: middle; margin-right: .5rem; }
        .avatar-fallback { display: inline-flex; align-items: center; justify-content: center; color: #fff; font-weight: 600; font-size: .8rem; }
        .avatar-lg { width: 72px; height: 72px; font-size: 1.5rem; }
        .bio { opacity: .8; font-style: italic; }
        /* Border/radius now come from the borrowed mud-paper-outlined class (see RichTextEditor.razor) —
           just clip the toolbar's background corners to match. */
        .rte { overflow: hidden; }
        .rte-toolbar { display: flex; gap: .25rem; padding: .3rem; border-bottom: 1px solid var(--border); background: var(--card-bg); }
        .rte-editor { padding: .45rem .5rem; min-height: 1.4rem; outline: none; }
        .rte-editor a { color: var(--link); }
        .truncate { max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .widget { max-width: 100%; overflow-x: auto; }
        .lang-switch { margin-left: .75rem; font-size: .9rem; opacity: .7; }
        .lang-switch a { text-decoration: none; }
        .lang-switch a.active { font-weight: 700; opacity: 1; text-decoration: underline; }
        .translation-row { display: flex; gap: .6rem; align-items: center; flex-wrap: wrap; margin: .4rem 0; }
        .translation-row .translation-key { flex-basis: 220px; opacity: .7; font-size: .85rem; }
        .translation-row label { display: flex; gap: .35rem; align-items: center; font-size: .85rem; }
        .translation-row input[type=text] { min-width: 220px; flex: 1; }
        button:focus-visible, a:focus-visible, input:focus-visible, [contenteditable]:focus-visible {
            outline: 2px solid var(--focus); outline-offset: 2px;
        }

        @@media (max-width: 640px) {
            .page { padding: 0 .75rem 2rem; }
            .actions { flex-direction: column; gap: .75rem; }

            /* MudBlazor ships mud-grid-item-{sm,md}-* as plain, unconditional classes (no media
               query of its own — the breakpoint is normally resolved by its own JS resize
               listener) — this is a plain CSS fallback that forces full-width stacking below the
               same breakpoint the rest of this file already uses. Nav links moved out of the app
               bar into MudDrawer (see MainLayout.razor) — the app bar itself no longer needs a
               wrap hack, it now only ever holds the hamburger/brand/lang-switch/user, which always
               fits on one line. */
            .mud-grid-item-sm-6, .mud-grid-item-md-3 { max-width: 100%; flex-basis: 100%; }

            /* Secondary MudDataGrid columns (e.g. History's Owner-only "Кем"/"Откуда") opt into
               this via HeaderClass/CellClass — collapses the whole cell, not just its content, so
               the grid doesn't leave empty gaps on narrow screens. MudBlazor's own responsive
               table mode (.mud-xs-table .mud-table-cell) sets display:flex at this same
               breakpoint with higher specificity (compound selector beats our single class), so
               this needs !important to actually win. */
            .hide-on-mobile { display: none !important; }
        }
    </style>
    <HeadOutlet />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="js/theme.js"></script>
    <script src="js/localtime.js"></script>
    <script src="js/richtext.js"></script>
</body>
</html>
