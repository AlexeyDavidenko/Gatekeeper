@inherits LayoutComponentBase
@implements IDisposable
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject CircuitVisitContext VisitContext
@inject SiteVisitQueue VisitQueue
@inject LocaleContext Locale
@inject Translator T

<MudThemeProvider Theme="_theme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<ReconnectModal />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <AuthorizeView>
            <Authorized>
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                               OnClick="@(() => _drawerOpen = !_drawerOpen)" />
            </Authorized>
        </AuthorizeView>
        <BrandMark />
        <MudSpacer />
        <span class="lang-switch">
            <a href="@LangUrl("ru")" class="@(Locale.LanguageCode == "ru" ? "active" : null)">RU</a>
            /
            <a href="@LangUrl("en")" class="@(Locale.LanguageCode == "en" ? "active" : null)">EN</a>
        </span>
        <AuthorizeView>
            <Authorized>
                <span class="user ml-4">@context.User.Identity?.Name</span>
                <form method="post" action="auth/logout" class="inline">
                    <AntiforgeryToken />
                    <button type="submit" class="link">@T["web.nav.logout"]</button>
                </form>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>
    <AuthorizeView>
        <Authorized>
            <MudDrawer @bind-Open="_drawerOpen" Breakpoint="Breakpoint.Md" Elevation="1" ClipMode="DrawerClipMode.Always">
                <MudNavMenu>
                    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">@T["web.nav.dashboard"]</MudNavLink>
                    <MudNavLink Href="/queue" Icon="@Icons.Material.Filled.PendingActions">@T["web.nav.queue"]</MudNavLink>
                    <MudNavLink Href="/history" Icon="@Icons.Material.Filled.History">@T["web.nav.history"]</MudNavLink>
                    <MudNavLink Href="/questions" Icon="@Icons.Material.Filled.QuestionAnswer">@T["web.nav.questions"]</MudNavLink>
                    <AuthorizeView Context="ownerContext" Roles="Owner">
                        <Authorized>
                            <MudNavLink Href="/visitors" Icon="@Icons.Material.Filled.Groups">@T["web.nav.visitors"]</MudNavLink>
                            <MudNavLink Href="/translations" Icon="@Icons.Material.Filled.Translate">@T["web.nav.translations"]</MudNavLink>
                        </Authorized>
                    </AuthorizeView>
                </MudNavMenu>
            </MudDrawer>
        </Authorized>
    </AuthorizeView>
    <MudMainContent Class="page">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _isDarkMode;
    private bool _drawerOpen = true;
    private string _previousPath = "/";

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight { Primary = "#2563eb" },
        PaletteDark = new PaletteDark { Primary = "#6ea8fe" },
    };

    protected override void OnInitialized()
    {
        _previousPath = CurrentPath();
        Nav.LocationChanged += OnLocationChanged;
    }

    // The current/initial location is already tracked with full, real HTTP detail by
    // SiteVisitMiddleware — this only fires for later in-circuit client-side navigations (e.g.
    // MudNavLink clicks), which stay on the open SignalR connection and never touch that
    // middleware at all. Method/StatusCode/DurationMs are synthetic markers: no real HTTP
    // request/response exists for these, so there's nothing genuine to report. Referrer is
    // repurposed as the previous in-circuit path, which is more useful here than a real HTTP
    // Referer would be for SPA-style navigation.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var path = CurrentPath();
        VisitQueue.Enqueue(new RecordSiteVisitRequest(
            VisitContext.UserId, VisitContext.UserName, VisitContext.SessionId, VisitContext.IpAddress,
            path, "BLAZOR", 200, 0, VisitContext.UserAgent, _previousPath));
        _previousPath = path;
    }

    private string CurrentPath()
    {
        var relative = Nav.ToBaseRelativePath(Nav.Uri);
        var cut = relative.IndexOfAny(['?', '#']);
        return "/" + (cut >= 0 ? relative[..cut] : relative);
    }

    private string LangUrl(string code) => $"lang/{code}?returnUrl={Uri.EscapeDataString(CurrentPath())}";

    // OS dark-mode preference is read once per circuit at startup — matches the existing plain-CSS
    // pages, which also only ever apply prefers-color-scheme at load, never live-react mid-session.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isDarkMode = await JS.InvokeAsync<bool>("gatekeeperTheme.prefersDark");
            StateHasChanged();
        }
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
