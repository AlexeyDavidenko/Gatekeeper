@inherits LayoutComponentBase

<div class="page">
    <header class="topbar">
        <a class="brand" href="/">Gatekeeper</a>
        <AuthorizeView>
            <Authorized>
                <a class="nav" href="/">Дашборд</a>
                <a class="nav" href="/queue">Очередь</a>
                <a class="nav" href="/questions">Вопросы</a>
                <AuthorizeView Context="ownerContext" Roles="Owner">
                    <Authorized>
                        <a class="nav" href="/audit">Аудит-лог</a>
                    </Authorized>
                </AuthorizeView>
                <span class="user">@context.User.Identity?.Name</span>
                <form method="post" action="auth/logout" class="inline">
                    <AntiforgeryToken />
                    <button type="submit" class="link">Выйти</button>
                </form>
            </Authorized>
        </AuthorizeView>
    </header>
    <main>
        @Body
    </main>
</div>
