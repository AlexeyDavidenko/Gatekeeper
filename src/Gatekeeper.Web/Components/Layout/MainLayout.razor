@inherits LayoutComponentBase
@implements IDisposable
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject CircuitVisitContext VisitContext
@inject SiteVisitQueue VisitQueue
@inject LocaleContext Locale
@inject Translator T

<MudThemeProvider Theme="_theme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<ReconnectModal />

<div class="page">
    <MudAppBar Elevation="1" Dense="true" Fixed="false">
        <MudText Typo="Typo.h6" Class="mr-4">Gatekeeper</MudText>
        <AuthorizeView>
            <Authorized>
                <MudNavLink Href="/" Match="NavLinkMatch.All">@T["web.nav.dashboard"]</MudNavLink>
                <MudNavLink Href="/queue">@T["web.nav.queue"]</MudNavLink>
                <MudNavLink Href="/history">@T["web.nav.history"]</MudNavLink>
                <MudNavLink Href="/questions">@T["web.nav.questions"]</MudNavLink>
                <AuthorizeView Context="ownerContext" Roles="Owner">
                    <Authorized>
                        <MudNavLink Href="/visitors">@T["web.nav.visitors"]</MudNavLink>
                        <MudNavLink Href="/translations">@T["web.nav.translations"]</MudNavLink>
                    </Authorized>
                </AuthorizeView>
                <MudSpacer />
                <span class="user">@context.User.Identity?.Name</span>
                <form method="post" action="auth/logout" class="inline">
                    <AntiforgeryToken />
                    <button type="submit" class="link">@T["web.nav.logout"]</button>
                </form>
            </Authorized>
        </AuthorizeView>
        <span class="lang-switch">
            <a href="@LangUrl("ru")" class="@(Locale.LanguageCode == "ru" ? "active" : null)">RU</a>
            /
            <a href="@LangUrl("en")" class="@(Locale.LanguageCode == "en" ? "active" : null)">EN</a>
        </span>
    </MudAppBar>
    <main>
        @Body
    </main>
</div>

@code {
    private bool _isDarkMode;
    private string _previousPath = "/";

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight { Primary = "#2563eb" },
        PaletteDark = new PaletteDark { Primary = "#6ea8fe" },
    };

    protected override void OnInitialized()
    {
        _previousPath = CurrentPath();
        Nav.LocationChanged += OnLocationChanged;
    }

    // The current/initial location is already tracked with full, real HTTP detail by
    // SiteVisitMiddleware — this only fires for later in-circuit client-side navigations (e.g.
    // MudNavLink clicks), which stay on the open SignalR connection and never touch that
    // middleware at all. Method/StatusCode/DurationMs are synthetic markers: no real HTTP
    // request/response exists for these, so there's nothing genuine to report. Referrer is
    // repurposed as the previous in-circuit path, which is more useful here than a real HTTP
    // Referer would be for SPA-style navigation.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var path = CurrentPath();
        VisitQueue.Enqueue(new RecordSiteVisitRequest(
            VisitContext.UserId, VisitContext.UserName, VisitContext.SessionId, VisitContext.IpAddress,
            path, "BLAZOR", 200, 0, VisitContext.UserAgent, _previousPath));
        _previousPath = path;
    }

    private string CurrentPath()
    {
        var relative = Nav.ToBaseRelativePath(Nav.Uri);
        var cut = relative.IndexOfAny(['?', '#']);
        return "/" + (cut >= 0 ? relative[..cut] : relative);
    }

    private string LangUrl(string code) => $"lang/{code}?returnUrl={Uri.EscapeDataString(CurrentPath())}";

    // OS dark-mode preference is read once per circuit at startup — matches the existing plain-CSS
    // pages, which also only ever apply prefers-color-scheme at load, never live-react mid-session.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isDarkMode = await JS.InvokeAsync<bool>("gatekeeperTheme.prefersDark");
            StateHasChanged();
        }
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
